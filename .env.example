# JWT
JWT_SECRET=your-jwt-secret-key-here

# Server
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Admin Seed Data
ADMIN_EMAIL=admin@hexschool.com
ADMIN_PASSWORD=12345678

# ECPay (AIO: credit card + ATM). Values below are ECPay's public staging account — use your own in production.
# ReturnURL (${BASE_URL}/api/ecpay/notify) is only reachable when BASE_URL is public on port 80/443 (e.g. ngrok);
# on localhost the payment is confirmed via OrderResultURL (browser POST) and QueryTradeInfo instead.
# ECPAY_ENV=production switches to payment.ecpay.com.tw; any other value uses payment-stage.
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
ECPAY_ENV=staging

# ATM virtual account validity in days (1-60, default 3)
ECPAY_ATM_EXPIRE_DAYS=3
# ATM on localhost: getting the account number works (ClientRedirectURL browser POST, or QueryPaymentInfo).
# Testing the paid step needs ECPay's back-office 模擬付款 (vendor-stage.ecpay.com.tw, stagetest3 / test1234),
# which only reaches ReturnURL — set BASE_URL to a public https URL (e.g. ngrok) for that.
